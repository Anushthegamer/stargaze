{
  "name": "stargaze",
  "version": "0.1.0",
  "private": true,
  "description": "Point your phone at the sky and it tells you what you are looking at. GPS, clock and compass -- no image recognition.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "data": "python tools/build_all.py",
    "dev": "npm run dev --workspace @stargaze/web",
    "build": "npm run build --workspace @stargaze/web",
    "test": "npm run test --workspace @stargaze/core",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
